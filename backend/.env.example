# NutriZero AI - Backend Environment Variables
# Copy this file to backend/.env and add your Google Gemini API key

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Recommended Gemini Model: gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash

# Backend Server Port
PORT=8000
